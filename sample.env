# ════════════════════════════════════════════════════
#            ShizuMusic — Environment Variables
# ════════════════════════════════════════════════════

# ── REQUIRED ────────────────────────────────────────

# Telegram API Credentials
# Get from: https://my.telegram.org
API_ID=
API_HASH=

# Telegram Bot Token
# Get from: @BotFather
BOT_TOKEN=

# Pyrogram String Session
# Generate from your assistant account
STRING_SESSION=

# MongoDB Database URL
# Get free cluster from: https://cloud.mongodb.com
MONGO_DB_URL=

# Your Telegram User ID
OWNER_ID=

# Logger Group / Channel ID
LOGGER_ID=

# ── BOT SETTINGS ────────────────────────────────────

BOT_NAME=
BOT_LINK=

UPDATES_CHANNEL=
SUPPORT_GROUP=

# ── MEDIA ───────────────────────────────────────────

START_PHOTOS=https://files.catbox.moe/jgt2vm.png
PING_IMG_URL=https://files.catbox.moe/ddzvc0.jpg

# ── SYSTEM ──────────────────────────────────────────

SESSION_NAME=ShizuMusic
PORT=10000

# ── LIMITS ──────────────────────────────────────────

MAX_DURATION_SECONDS=1800
QUEUE_LIMIT=20
COOLDOWN=10

# ── AI ──────────────────────────────────────────────

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

AI_TIMEOUT=45
AI_MAX_TOKENS=1200

AI_SYSTEM_PROMPT=You are the helpful AI assistant inside a Telegram music bot. Answer clearly, accurately, and concisely. Do not claim to have abilities you do not have.
